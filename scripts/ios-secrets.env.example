# iOS TestFlight 공통 Secrets — 이 파일을 ~/.config/ios-secrets.env 로 복사해 값을 채운다.
# ⚠️ 실제 값이 든 파일은 절대 git에 커밋하지 말 것. (chmod 600 권장)

# App Store Connect API 키 (Users and Access → Integrations → Team Keys)
APP_STORE_CONNECT_KEY_ID=ABC123DEFG
APP_STORE_CONNECT_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# .p8 파일의 base64 인코딩:  base64 -w0 AuthKey_ABC123DEFG.p8   (macOS는 base64 -i 파일명)
APP_STORE_CONNECT_KEY=LS0tLS1CRUdJTi...

# developer.apple.com → Membership 페이지
APPLE_TEAM_ID=AB12CD34EF

# fastlane match 인증서 보관용 private repo (모든 앱이 공유)
MATCH_GIT_URL=https://github.com/sangmin082/ios-certificates.git
# "깃허브계정:PAT" 형식 (PAT 단독이나 base64도 허용됨)
MATCH_GIT_BASIC_AUTHORIZATION=sangmin082:ghp_xxxxxxxxxxxx
# 인증서 암호화 비밀번호 — 같은 인증서 repo를 쓰는 모든 앱에서 동일해야 함
MATCH_PASSWORD=원하는비밀번호
